#!/usr/bin/env python3
from __future__ import annotations
import hashlib,json,subprocess,tempfile
from pathlib import Path
ROOT=Path(__file__).resolve().parents[2]; BASE=ROOT/"product"/"src"/"examples"/"task-tracker"; BUILDER=ROOT/"product"/"src"/"app_builder.py"; ADR="https://github.com/wiigelec/adr.git"; PROVIDERS=["generic-self-contained","microsoft-copilot"]
def sha(p): return hashlib.sha256(p.read_bytes()).hexdigest()
def adr_main(): return subprocess.run(["git","ls-remote",ADR,"refs/heads/main"],text=True,capture_output=True,check=True).stdout.strip().split()[0]
def builder_commit(): return subprocess.run(["git","log","-1","--format=%H","--","product/src/app_builder.py"],cwd=ROOT,text=True,capture_output=True,check=True).stdout.strip()
def run_build(out): subprocess.run(["python3",str(BUILDER),"--application",str(BASE/"application.json"),"--ruleset",str(BASE/"ruleset.json"),"--dataset",str(BASE/"dataset.json"),"--build",str(BASE/"build.json"),"--output-dir",str(out)],cwd=ROOT,check=True)
def main():
    src=[BASE/x for x in ["application.json","ruleset.json","dataset.json","build.json"]]; before={p:sha(p) for p in src}; adr=adr_main(); bc=builder_commit(); app=json.loads((BASE/"application.json").read_text()); rules=json.loads((BASE/"ruleset.json").read_text()); dataset=json.loads((BASE/"dataset.json").read_text())
    with tempfile.TemporaryDirectory() as a,tempfile.TemporaryDirectory() as b:
        pa,pb=Path(a),Path(b); run_build(pa); run_build(pb)
        for pid in PROVIDERS:
            aa,bb=pa/f"{pid}.json",pb/f"{pid}.json"
            if not aa.is_file() or aa.read_bytes()!=bb.read_bytes(): raise SystemExit(f"FAIL: deterministic provider output {pid}")
            r=json.loads(aa.read_text())["adr_realization"]
            if r["provenance"]!={"adr_commit":adr,"app_builder_commit":bc}: raise SystemExit(f"FAIL: provenance {pid}")
            if r["application"]!=app or r["ruleset"]!=rules or r["dataset"]!=dataset: raise SystemExit(f"FAIL: source fidelity {pid}")
            if r["initialization"]["application"]!=app["initialization"] or r["initialization"]["provider"].get("mode")!="initialize": raise SystemExit(f"FAIL: initialization separation {pid}")
            if r["preservation"].get("writeback")!="complete-realization" or r["preservation"].get("preserve_non_dataset_realization_material") is not True: raise SystemExit(f"FAIL: preservation {pid}")
        if sorted(p.name for p in pa.glob("*.json"))!=sorted(f"{p}.json" for p in PROVIDERS): raise SystemExit("FAIL: provider set")
    for p,d in before.items():
        if sha(p)!=d: raise SystemExit(f"FAIL: source mutated {p.relative_to(ROOT)}")
    print("PASS: FS-001 resolves ADR main, records dual provenance, generates both providers, preserves sources, separates initialization, carries complete-realization preservation, and is deterministic for resolved inputs.")
if __name__=="__main__": main()
